<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sidebar_container"
    android:layout_width="56dp"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Top Stacked Digital Clock -->
    <LinearLayout
        android:id="@+id/clock_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/clock_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh"
            android:format24Hour="HH"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/clock_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Category Dock Pills -->
    <FrameLayout
        android:id="@+id/cat_container_0"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp">
        <ImageView
            android:id="@+id/cat_bg_0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/pill_inactive" />
        <ImageView
            android:id="@+id/cat_icon_0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cat_container_1"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp">
        <ImageView
            android:id="@+id/cat_bg_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/pill_inactive" />
        <ImageView
            android:id="@+id/cat_icon_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cat_container_2"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp">
        <ImageView
            android:id="@+id/cat_bg_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/pill_inactive" />
        <ImageView
            android:id="@+id/cat_icon_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cat_container_3"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp">
        <ImageView
            android:id="@+id/cat_bg_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/pill_inactive" />
        <ImageView
            android:id="@+id/cat_icon_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cat_container_4"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp">
        <ImageView
            android:id="@+id/cat_bg_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/pill_inactive" />
        <ImageView
            android:id="@+id/cat_icon_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cat_container_5"
        android:layout_width="44dp"
        android:layout_height="36dp">
        <ImageView
            android:id="@+id/cat_bg_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/pill_inactive" />
        <ImageView
            android:id="@+id/cat_icon_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside" />
    </FrameLayout>
</LinearLayout>
